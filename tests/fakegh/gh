#!/usr/bin/env python3
import json
import os
import re
import sys
from pathlib import Path

STATE = Path(os.environ["FAKE_GH_STATE"])
LOG = Path(os.environ["FAKE_GH_LOG"])
REVIEWS = re.compile(r"^repos/[^/]+/[^/]+/pulls/\d+/reviews$")
REVIEW_COMMENTS = re.compile(r"^repos/[^/]+/[^/]+/pulls/\d+/reviews/(\d+)/comments$")
FILES = re.compile(r"^repos/[^/]+/[^/]+/pulls/\d+/files$")
COMMENTS = re.compile(r"^repos/[^/]+/[^/]+/pulls/\d+/comments$")
REPLIES = re.compile(r"^repos/[^/]+/[^/]+/pulls/\d+/comments/(\d+)/replies$")
EDIT = re.compile(r"^repos/[^/]+/[^/]+/pulls/comments/(\d+)$")


def option(args, name):
    return args[args.index(name) + 1] if name in args else None


def fail(message):
    sys.stderr.write(message)
    sys.exit(1)


def new_comment(state, payload):
    state["next_id"] += 1
    comment_id = state["next_id"]
    return {"id": comment_id, "html_url": f"https://github.com/acme/widgets/pull/7#discussion_r{comment_id}", **payload}


def api(args, state, payload):
    endpoint = next(arg for arg in args[1:] if arg.startswith("repos/"))
    if any(fragment in endpoint for fragment in state.get("fail_on", [])):
        fail("HTTP 422: Unprocessable Entity")
    if FILES.match(endpoint):
        return [state["files"]]
    if REVIEWS.match(endpoint):
        state["next_id"] += 1
        review_id = state["next_id"]
        state["review_comments"][str(review_id)] = [new_comment(state, item) for item in payload.get("comments", [])]
        return {"id": review_id, "html_url": f"https://github.com/acme/widgets/pull/7#pullrequestreview-{review_id}"}
    if match := REVIEW_COMMENTS.match(endpoint):
        return [state["review_comments"][match[1]]]
    if COMMENTS.match(endpoint) or REPLIES.match(endpoint):
        return new_comment(state, payload)
    if EDIT.match(endpoint):
        return {"id": int(EDIT.match(endpoint)[1]), **payload}
    fail(f"unexpected endpoint {endpoint}")


def pull_requests(args, state):
    if args[1] == "view":
        found = [pr for pr in state["prs"] if str(pr["number"]) == args[2]]
        return found[0] if found else fail("no pull requests found")
    if "--head" not in args:
        return [pr for pr in state["prs"] if pr.get("state", "OPEN") == "OPEN"]
    return [pr for pr in state["prs"] if pr["headRefName"] == option(args, "--head") and pr["baseRefName"] == option(args, "--base")]


def variable(args, name):
    return next(arg.split("=", 1)[1] for arg in args if arg.startswith(f"{name}="))


def file_views(args, state):
    pull = next(pr for pr in state["prs"] if pr["number"] == int(variable(args, "number")))
    viewed = state.get("viewed", [])
    nodes = [{"path": item["filename"], "viewerViewedState": "VIEWED" if item["filename"] in viewed else "UNVIEWED"} for item in state["files"]]
    files = None if state.get("files_unavailable") else {"nodes": nodes, "pageInfo": {"hasNextPage": False, "endCursor": None}}
    return [{"data": {"repository": {"pullRequest": {"id": f"PR_{pull['number']}", "headRefOid": pull["headRefOid"], "files": files}}}}]


def set_files_viewed(args, state):
    if state.get("fail_viewed_request"):
        fail(state["fail_viewed_request"])
    viewed = not any("unmarkFileAsViewed" in arg for arg in args)
    fields = {f"f{match[1]}": arg.split("=", 1)[1] for arg in args if (match := re.match(r"^p(\d+)=", arg))}
    refused = state.get("fail_viewed", [])
    done = [path for path in fields.values() if path not in refused]
    current = state.get("viewed", [])
    state["viewed"] = [*current, *done] if viewed else [path for path in current if path not in done]
    if viewed and "push_on_mark" in state:
        state["prs"][0]["headRefOid"] = state.pop("push_on_mark")
    STATE.write_text(json.dumps(state))
    errors = [{"path": [field], "message": f"Could not mark {path} as viewed"} for field, path in fields.items() if path in refused]
    if errors:
        print(json.dumps({"data": {field: None for field in fields}, "errors": errors}))
        fail("GraphQL: Could not mark the files as viewed")
    return {"data": {field: {"clientMutationId": None} for field in fields}}


def main():
    args = sys.argv[1:]
    state = json.loads(STATE.read_text())
    payload = json.loads(sys.stdin.read() or "null") if "--input" in args else None
    with LOG.open("a") as log:
        log.write(json.dumps({"args": args, "input": payload}) + "\n")
    if args[:2] == ["auth", "status"]:
        sys.exit(0 if state.get("authenticated", True) else 1)
    if args[:2] == ["auth", "token"]:
        print("fake-token")
        return
    if args[:2] == ["api", "graphql"] and any("ReviewThread(input" in arg for arg in args):
        if state.get("fail_resolve"):
            fail("GraphQL: Resource not accessible by integration")
        thread_id = variable(args, "threadId")
        resolved = not any("unresolveReviewThread" in arg for arg in args)
        for thread in state.get("conversation", {}).get("reviewThreads", []):
            if thread.get("id") == thread_id:
                thread["isResolved"] = resolved
        STATE.write_text(json.dumps(state))
        print(json.dumps({"data": {"thread": {"isResolved": resolved}}}))
        return
    if args[:2] == ["api", "graphql"] and any("markFileAsViewed(input" in arg for arg in args):
        print(json.dumps(set_files_viewed(args, state)))
        return
    if args[:2] == ["api", "graphql"] and any("viewerViewedState" in arg for arg in args):
        print(json.dumps(file_views(args, state)))
        return
    if args[:2] == ["api", "graphql"] and any("pullRequest(number" in arg for arg in args):
        conversation = state.get("conversation", {})
        number = int(variable(args, "number"))
        found = [pr for pr in state["prs"] if pr["number"] == number]
        pull = None
        if found:
            pull = {key: value for key, value in found[0].items() if key not in ("comments", "reviewThreads")}
            pull.update({key: {"nodes": conversation.get(key, [])} for key in ("comments", "reviews", "reviewThreads")})
        print(json.dumps({"data": {"viewer": {"login": state.get("viewer", "alice-gh")}, "repository": {"pullRequest": pull}}}))
        return
    if args[:2] == ["api", "graphql"]:
        open_pulls = [pr for pr in state["prs"] if pr.get("state", "OPEN") == "OPEN"]
        print(json.dumps({"data": {"repository": {"pullRequests": {"nodes": open_pulls}}}}))
        return
    result = pull_requests(args, state) if args[0] == "pr" else api(args, state, payload)
    STATE.write_text(json.dumps(state))
    print(json.dumps(result))


main()
